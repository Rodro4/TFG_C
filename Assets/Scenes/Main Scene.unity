    <imageTopicName>rgb/image_raw</imageTopicName>\r\n      <depthImageTopicName>depth/image_raw</depthImageTopicName>\r\n     
    <pointCloudTopicName>depth/points</pointCloudTopicName>\r\n      <cameraInfoTopicName>rgb/camera_info</cameraInfoTopicName>\r\n     
    <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>\r\n     
    <frameName>camera_depth_optical_frame</frameName>\r\n      <baseline>0.1</baseline>\r\n     
    <distortion_k1>0.0</distortion_k1>\r\n      <distortion_k2>0.0</distortion_k2>\r\n     
    <distortion_k3>0.0</distortion_k3>\r\n      <distortion_t1>0.0</distortion_t1>\r\n     
    <distortion_t2>0.0</distortion_t2>\r\n      <pointCloudCutoff>0.4</pointCloudCutoff>\r\n   
    </plugin>\r\n  </sensor>\r\n</gazebo>"
--- !u!114 &2064080359
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2064080356}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1655703e81bb23f44bb29363181d9d19, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo>\r\n  <plugin filename=\"libgazebo_ros_kobuki.so\" name=\"kobuki_controller\">\r\n   
    <publish_tf>1</publish_tf>\r\n    <left_wheel_joint_name>wheel_left_joint</left_wheel_joint_name>\r\n   
    <right_wheel_joint_name>wheel_right_joint</right_wheel_joint_name>\r\n    <wheel_separation>.230</wheel_separation>\r\n   
    <wheel_diameter>0.070</wheel_diameter>\r\n    <torque>1.0</torque>\r\n    <velocity_command_timeout>0.6</velocity_command_timeout>\r\n   
    <cliff_sensor_left_name>cliff_sensor_left</cliff_sensor_left_name>\r\n    <cliff_sensor_center_name>cliff_sensor_front</cliff_sensor_center_name>\r\n   
    <cliff_sensor_right_name>cliff_sensor_right</cliff_sensor_right_name>\r\n   
    <cliff_detection_threshold>0.04</cliff_detection_threshold>\r\n    <bumper_name>bumpers</bumper_name>\r\n   
    <imu_name>imu</imu_name>\r\n  </plugin>\r\n</gazebo>"
--- !u!114 &2064080360
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2064080356}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1655703e81bb23f44bb29363181d9d19, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"gyro_link\">\r\n  <sensor name=\"imu\" type=\"imu\">\r\n   
    <always_on>true</always_on>\r\n    <update_rate>50</update_rate>\r\n    <visualize>false</visualize>\r\n   
    <imu>\r\n      <noise>\r\n        <type>gaussian</type>\r\n        <rate>\r\n         
    <mean>0.0</mean>\r\n          <stddev>1.96e-06</stddev>\r\n          <!-- 0.25
    x 0.25 (deg/s) -->\r\n          <bias_mean>0.0</bias_mean>\r\n          <bias_stddev>0.0</bias_stddev>\r\n       
    </rate>\r\n        <accel>\r\n          <!-- not used in the plugin and real
    robot, hence using tutorial values -->\r\n          <mean>0.0</mean>\r\n         
    <stddev>1.7e-2</stddev>\r\n          <bias_mean>0.1</bias_mean>\r\n         
    <bias_stddev>0.001</bias_stddev>\r\n        </accel>\r\n      </noise>\r\n   
    </imu>\r\n  </sensor>\r\n</gazebo>"
--- !u!114 &2064080361
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2064080356}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1655703e81bb23f44bb29363181d9d19, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"cliff_sensor_front_link\">\r\n  <sensor name=\"cliff_sensor_front\"
    type=\"ray\">\r\n    <always_on>true</always_on>\r\n    <update_rate>50</update_rate>\r\n   
    <visualize>true</visualize>\r\n    <ray>\r\n      <scan>\r\n        <horizontal>\r\n         
    <samples>50</samples>\r\n          <resolution>1.0</resolution>\r\n         
    <min_angle>-0.0436</min_angle>\r\n          <!-- -2.5 degree -->\r\n         
    <max_angle>0.0436</max_angle>\r\n          <!-- 2.5 degree -->\r\n        </horizontal>\r\n       
    <!-- \\t          Can't use vertical rays until this bug is resolved: -->\r\n       
    <!--            https://bitbucket.org/osrf/gazebo/issue/509/vertical-sensor-doesnt-works
    -->\r\n        <!-- \\t          <vertical> -->\r\n        <!-- \\t           
    <samples>50</samples> -->\r\n        <!-- \\t            <resolution>1.0</resolution>
    -->\r\n        <!-- \\t            <min_angle>-0.0436</min_angle>  -2.5 degree
    -->\r\n        <!-- \\t            <max_angle>0.0436</max_angle> 2.5 degree -->\r\n       
    <!-- \\t          </vertical> -->\r\n      </scan>\r\n      <range>\r\n       
    <min>0.01</min>\r\n        <max>0.15</max>\r\n        <resolution>1.0</resolution>\r\n     
    </range>\r\n    </ray>\r\n  </sensor>\r\n</gazebo>"
